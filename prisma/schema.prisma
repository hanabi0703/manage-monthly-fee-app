// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum PaymentType {
  MONTHLY
  VISITOR
}

model Member {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  payments  Payment[]
}

// The standard monthly fee amount, with history so changes over time
// can be tracked (used to compute each member's carryover balance).
model FeeSetting {
  id            String   @id @default(cuid())
  amount        Int
  effectiveFrom DateTime
  createdAt     DateTime @default(now())
}

model Payment {
  id        String      @id @default(cuid())
  date      DateTime
  member    Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  String
  amount    Int
  type      PaymentType
  createdAt DateTime    @default(now())

  @@index([date])
  @@index([memberId])
}
